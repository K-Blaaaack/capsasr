pkgbase = capsasr
	pkgdesc = 本地语音输入: 长按 CapsLock 说话, 松手识别粘贴 (引擎 Fun-ASR-Nano GGUF, 无 PyTorch)
	pkgver = 0.4.1
	pkgrel = 1
	url = https://github.com/Wry-Zen/capsasr
	arch = x86_64
	license = MIT
	license = Apache-2.0
	makedepends = patchelf
	options = !debug
	source = https://github.com/Wry-Zen/capsasr/archive/refs/tags/v0.4.1.tar.gz
	source = https://github.com/Wry-Zen/capsasr/releases/download/v0.4.1/capsasr-engine-vulkan
	source = https://github.com/Wry-Zen/capsasr/releases/download/v0.4.1/capsasr-engine-cuda
	sha256sums = SKIP
	sha256sums = ece4e23794fa37641bbd52057aff491feb18a5eb5f2a532377130bbec4065c60
	sha256sums = 81003f5e6d001f2839149e1375f7f7727728301625339de81e3f46d34fc46b64

pkgname = capsasr
	install = capsasr.install
	depends = bash
	depends = glibc
	depends = libstdc++
	depends = libgcc
	depends = libgomp
	depends = python
	depends = keyd
	depends = wl-clipboard
	depends = ydotool
	depends = libnotify
	depends = pipewire
	depends = pipewire-pulse
	depends = vulkan-icd-loader
	optdepends = vulkan-tools: 设备探测回退
	optdepends = bash-completion: bash 自动加载补全

pkgname = capsasr-cuda
	pkgdesc = CapsASR CUDA(sm_120) 引擎后端 (Blackwell; auto 模式下优先于 Vulkan)
	depends = capsasr
	depends = glibc
	depends = libstdc++
	depends = libgcc
	depends = libgomp
	depends = nvidia-utils
	depends = cuda
	depends = nccl
