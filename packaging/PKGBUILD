# CapsASR 打包脚本（Arch；Release 分发优先，AUR 可选）
#
# 布局: /usr/bin/{capsasr,capsasr-daemon}（控制命令, 进 PATH）
#       /usr/lib/capsasr/{capsasr,engines,tools}（核心运行体, 不进 PATH, 防与系统 llama.cpp 冲突）
# 包不含模型与用户配置——装包后 `capsasr init` 完成（数据落 ~/.capsasr）。
#
# 发布前（顺序）:
#   1. 代码推上去并打 tag v$pkgver（_repo 已指向真实仓库）
#   2. 建 Release v$pkgver，上传两个引擎二进制 capsasr-engine-{vulkan,cuda}
#   3. sha256sum 两个二进制，把真实值填进 sha256sums（源码归档可留 SKIP）
#   4. makepkg -sf 构建包，把 capsasr-$pkgver-$pkgrel-x86_64.pkg.tar.zst 也上传到该 Release
#   5. （可选，AUR 恢复注册后）makepkg --printsrcinfo > .SRCINFO，与 PKGBUILD 提交 AUR
#
# 本地验证（未发布时，绕过网络）:
#   tar --exclude='./models' --exclude='./engines' --exclude='./packaging' -czf /tmp/src.tar.gz -C . .
#   cd packaging && _code=/tmp/src.tar.gz \
#       _engine=$PWD/../engines/capsasr-engine-vulkan \
#       _engine_cuda=$PWD/../engines/capsasr-engine-cuda makepkg -f

pkgname=capsasr
pkgver=0.4.0
pkgrel=3
pkgdesc="本地语音输入: 长按 CapsLock 说话, 松手识别粘贴 (引擎 Fun-ASR-Nano GGUF, 无 PyTorch)"
arch=(x86_64)
_repo="https://github.com/Wry-Zen/capsasr"
url="$_repo"
license=(MIT Apache-2.0)
install=capsasr.install
depends=(python keyd wl-clipboard ydotool libnotify pipewire pipewire-pulse vulkan-icd-loader)
optdepends=(
  'vulkan-tools: 设备探测回退'
  'cuda: CUDA 后端运行库'
  'bash-completion: bash 自动加载补全'
)
options=(!debug)

: "${_code:=${_repo}/archive/refs/tags/v${pkgver}.tar.gz}"
: "${_engine:=${_repo}/releases/download/v${pkgver}/capsasr-engine-vulkan}"
: "${_engine_cuda:=${_repo}/releases/download/v${pkgver}/capsasr-engine-cuda}"
source=("$_code" "$_engine" "$_engine_cuda")
sha256sums=(SKIP 47cb4b4ac4014f7f0e67b8a0f5755f3b5b9069923f89b27833c8d880efda0dc9 81003f5e6d001f2839149e1375f7f7727728301625339de81e3f46d34fc46b64)

package() {
    cd "$srcdir"
    # GitHub tag 归档解压后是 $pkgname-$pkgver/ 顶层目录；本地验证 tarball 是扁平结构
    if [ -d "$pkgname-$pkgver" ]; then
        cd "$pkgname-$pkgver"
    fi

    _app="$pkgdir/usr/lib/capsasr"
    install -dm755 "$_app/capsasr" "$_app/engines" "$_app/tools" "$pkgdir/usr/bin"

    install -Dm644 capsasr/*.py -t "$_app/capsasr/"
    install -m755 "$srcdir/capsasr-engine-vulkan" "$_app/engines/capsasr-engine-vulkan"
    install -m755 "$srcdir/capsasr-engine-cuda" "$_app/engines/capsasr-engine-cuda"
    install -Dm755 bin/capsasr bin/capsasr-daemon -t "$pkgdir/usr/bin/"
    install -Dm755 tools/setup-keyd.sh -t "$_app/tools/"
    install -Dm644 tools/funasr-cli.patch -t "$_app/tools/"

    install -Dm644 completions/capsasr.bash "$pkgdir/usr/share/bash-completion/completions/capsasr"
    install -Dm644 completions/_capsasr "$pkgdir/usr/share/zsh/site-functions/_capsasr"
    install -Dm644 completions/capsasr.fish "$pkgdir/usr/share/fish/vendor_completions.d/capsasr.fish"

    install -Dm644 /dev/stdin "$pkgdir/usr/share/doc/capsasr/README" <<'EOF'
初始化: capsasr init
体检:   capsasr doctor
热键:   sudo bash /usr/lib/capsasr/tools/setup-keyd.sh
EOF
}
