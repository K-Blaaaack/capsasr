pre_remove() {
    echo "==> 建议先以普通用户执行: capsasr uninstall"
    echo "    （清理自启条目/用户服务/进程；--purge 连 ~/.capsasr 模型数据一起删除）"
}

post_remove() {
    echo "==> 若未提前执行 capsasr uninstall，用户级残留请手动清理（普通用户）:"
    echo "    rm -f ~/.config/autostart/capsasr.desktop ~/.config/systemd/user/capsasr.service"
    echo "    rm -rf ~/.capsasr   # 模型与配置"
    echo "==> 恢复 CapsLock 原功能（root，可选）:"
    echo "    rm -f /etc/keyd/default.conf && systemctl restart keyd"
}
