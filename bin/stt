#!/usr/bin/env python3
"""stt 控制命令入口。布局自发现：安装态 {prefix}/bin → {prefix}/lib/funasr-nano；
仓库态 bin → 仓库根。用法见 `stt --help`。"""

import sys
from pathlib import Path

_here = Path(__file__).resolve()
for _cand in (_here.parent.parent / "lib/funasr-nano", _here.parent.parent):
    if (_cand / "voiced" / "cli.py").is_file():
        sys.path.insert(0, str(_cand))
        break
else:
    print("找不到 voiced 包（应与 bin/ 或 lib/funasr-nano/ 同级安装）", file=sys.stderr)
    sys.exit(2)

from voiced.cli import main  # noqa: E402

sys.exit(main())
